{
  "TemplateName": "GrocerymateNewProduct",
  "TemplateContent": {
    "Subject": "New product available: {{product.product_name}}",
    "Text": "New product: {{product.product_name}} (SKU: {{product.sku}}) - Price: {{product.price}}",
    "Html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>New product</title></head><body style=\"margin:0;padding:0;background:#f6f7f9;font-family:Arial,Helvetica,sans-serif;color:#111\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f6f7f9;padding:24px 0\"><tr><td align=\"center\"><table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;width:100%;background:#fff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb\"><tr><td style=\"padding:24px 24px 8px\"><h1 style=\"margin:0 0 8px;font-size:24px;line-height:1.3\">New product available</h1><p style=\"margin:0 0 4px\"><strong>Name:</strong> {{product.product_name}}</p><p style=\"margin:0 0 4px\"><strong>SKU:</strong> {{product.sku}}</p><p style=\"margin:0 0 16px\"><strong>Price:</strong> {{product.price}}</p></td></tr><tr><td style=\"padding:0 24px 16px\"><img src=\"{{product.image_url}}\" alt=\"{{product.product_name}}\" style=\"display:block;width:100%;max-width:552px;height:auto;border-radius:10px;border:1px solid #e5e7eb;background:#eee\" /></td></tr><tr><td style=\"padding:0 24px 24px\"><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td style=\"border-radius:8px;background:#111\"><a href=\"{{product.product_url}}\" style=\"display:inline-block;padding:12px 16px;color:#ffffff;text-decoration:none;font-weight:bold\">View product</a></td><td width=\"12\"></td><td style=\"border-radius:8px;background:#e5e7eb\"><a href=\"{{product.manage_prefs_url}}\" style=\"display:inline-block;padding:12px 16px;color:#111;text-decoration:none;font-weight:bold\">Manage preferences</a></td></tr></table></td></tr><tr><td style=\"padding:16px 24px;background:#fafafa;border-top:1px solid #eee;color:#6b7280;font-size:12px\">You are receiving this because you subscribed to GroceryMate product updates.</td></tr></table></td></tr></table></body></html>"
  }
}
